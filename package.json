{
  "name": "fullstatus",
  "version": "1.0.0",
  "description": "Registro institucional de asistencia",
  "main": "electron-main.cjs",
  "scripts": {
    "start:web": "node server.cjs",
    "start:windows": "electron .",
    "dist:windows": "electron-builder --win nsis --x64",
    "sync:www": "node sync-www.cjs",
    "sync:android": "node sync-www.cjs && cap sync android"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.prismalmesh.fullstatus",
    "productName": "FullStatus",
    "files": [
      "electron-main.cjs",
      "index.html",
      "styles.css",
      "app.js",
      "manifest.webmanifest",
      "server.cjs",
      "FullStatus.png",
      "FS.png",
      "package.json",
      "vendor/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "FS.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FullStatus"
    }
  }
}
